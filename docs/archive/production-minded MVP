# docker-compose.yml

```yaml
version: "3.9"

services:

  postgres:
    image: postgres:17
    container_name: memorial-postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB: memorial
      POSTGRES_USER: memorial
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - ./storage/postgres:/var/lib/postgresql/data
    networks:
      - memorial

  directus:
    image: directus/directus:latest
    container_name: memorial-directus
    restart: unless-stopped
    depends_on:
      - postgres
    environment:
      SECRET: ${DIRECTUS_SECRET}
      ADMIN_EMAIL: ${ADMIN_EMAIL}
      ADMIN_PASSWORD: ${ADMIN_PASSWORD}
      DB_CLIENT: pg
      DB_HOST: postgres
      DB_PORT: 5432
      DB_DATABASE: memorial
      DB_USER: memorial
      DB_PASSWORD: ${POSTGRES_PASSWORD}
    volumes:
      - ./storage/directus:/directus/uploads
    networks:
      - memorial

  n8n:
    image: n8nio/n8n:latest
    container_name: memorial-n8n
    restart: unless-stopped
    environment:
      N8N_HOST: n8n.local
      WEBHOOK_URL: https://yourdomain/flow/
      GENERIC_TIMEZONE: Europe/Amsterdam
    volumes:
      - ./storage/n8n:/home/node/.n8n
    networks:
      - memorial

  minio:
    image: minio/minio:latest
    container_name: memorial-minio
    command: server /data --console-address ":9001"
    restart: unless-stopped
    environment:
      MINIO_ROOT_USER: ${MINIO_USER}
      MINIO_ROOT_PASSWORD: ${MINIO_PASSWORD}
    volumes:
      - ./storage/minio:/data
    networks:
      - memorial

  paddleocr:
    image: paddlex/paddlex:latest
    container_name: memorial-paddleocr
    restart: unless-stopped
    command: sleep infinity
    networks:
      - memorial

  caddy:
    image: caddy:latest
    container_name: memorial-caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile
      - caddy_data:/data
    networks:
      - memorial

volumes:
  caddy_data:

networks:
  memorial:
```

